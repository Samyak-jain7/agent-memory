# Development only. Supply values locally; never commit .env.
POSTGRES_PASSWORD=
MEMORY_DB_PASSWORD=
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:54329/memory_dev
# Restricted LOGIN role with membership in memory_app, never schema owner/admin:
DATABASE_URL=postgresql+psycopg://memory_service:PASSWORD@127.0.0.1:54329/memory_dev
MEMORY_AUTH_SECRET=
MODEL_PROVIDER=offline
ERASURE_RETENTION_SECONDS=0
API_URL=http://127.0.0.1:8000
# Live extraction and verification are opt-in; embeddings remain MODEL_PROVIDER.
EXTRACTION_PROVIDER=offline
EXTRACTION_MODEL=gemini-3.5-flash-lite
MEMORY_VERIFIER=none
JEV_MODEL=jev-1.13.0
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# Local private review files, supplied only after account/model/free quota checks:
GEMINI_FREE_TIER_FILE=
TYPESAFE_FREE_TIER_FILE=
